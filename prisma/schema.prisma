generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  moderator
  admin
}

enum ModerationStatus {
  visible
  flagged
  hidden
}

enum ReactionType {
  laugh
  shock
  cry
  love
  fire
  eyes
}

model User {
  id          String           @id @default(cuid())
  twitchId    String           @unique
  username    String           @unique
  displayName String
  avatarUrl   String
  role        UserRole         @default(user)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  lastLoginAt DateTime?
  isMuted     Boolean          @default(false)
  isBanned    Boolean          @default(false)
  comments    TimedComment[]
  reactions   TimedReaction[]
  reviews     PostFilmReview[]
}

model Film {
  id              String           @id @default(cuid())
  title           String
  slug            String           @unique
  tagline         String
  description     String
  director        String
  releaseYear     Int
  durationSeconds Int
  videoUrl        String
  posterUrl       String
  coverUrl        String
  genres          String
  cast            String
  isActive        Boolean          @default(false)
  isArchived      Boolean          @default(false)
  publishedAt     DateTime
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  comments        TimedComment[]
  reactions       TimedReaction[]
  reviews         PostFilmReview[]
}

model TimedComment {
  id               String           @id @default(cuid())
  filmId           String
  userId           String
  timestampSeconds Int
  body             String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  isDeleted        Boolean          @default(false)
  moderationStatus ModerationStatus @default(visible)
  film             Film             @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([filmId, timestampSeconds])
}

model TimedReaction {
  id               String       @id @default(cuid())
  filmId           String
  userId           String
  timestampSeconds Int
  reactionType     ReactionType
  emoji            String
  createdAt        DateTime     @default(now())
  film             Film         @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([filmId, timestampSeconds])
}

model PostFilmReview {
  id        String   @id @default(cuid())
  filmId     String
  userId     String
  body       String
  isSpoiler  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isDeleted  Boolean  @default(false)
  film       Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([filmId, isSpoiler])
}
